# ── Reseller portal → main Onita app integration ─────────────────────────────
# The reseller portal (/reseller) is a thin BFF client of the main Onita app. It
# holds NO database of its own; it calls the main app's central /reseller/* API
# server-to-server. Copy this file to `.env.local` and fill real values.

# Base URL of the main Onita app's API (include the /api suffix).
#   dev:  http://localhost:8080/api
#   prod: https://app.onitaapp.com/api
ONITA_API_URL=https://app.onitaapp.com/api

# Shared secret the main app's /reseller/* API requires (header x-reseller-key).
# MUST match RESELLER_SERVICE_SECRET set on the main app. Use a long random string.
RESELLER_SERVICE_SECRET=replace-with-a-long-random-shared-secret
